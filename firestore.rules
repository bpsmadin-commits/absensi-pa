rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // INTERIM: siapa pun yang membuka aplikasi (proxy auth anonim) bisa baca/tulis.
    // Hardening per-role (admin tulis jadwal, guru hanya absensi sendiri) = tahap berikutnya.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}